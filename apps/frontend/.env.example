# Copy to .env.local for local development against a remote backend, or set these in Vercel
# (Project Settings -> Environment Variables). Vite bakes them in at build time, so redeploy after changing them.
#
# URL of the deployed FastAPI backend (no trailing slash). The WebSocket URL is derived from it automatically.
VITE_API_URL=https://your-backend.onrender.com
# Optional: set the WebSocket URL explicitly instead.
# VITE_WS_URL=wss://your-backend.onrender.com/ws/telemetry
